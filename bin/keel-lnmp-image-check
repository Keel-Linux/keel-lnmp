#!/bin/bash
# Run by conf.d/main at the end of the build, in the image chroot of the
# lnmp layer. It changes nothing: it fails the build when the image is not
# what a first boot of Keel LNMP starts from (handbook decision 0059), and
# reports every problem it finds.
#
# - Nothing of Apache: no apache2, no libapache2-mod-php* installed.
# - The socket units of MariaDB masked (keel-mariadb#29): with one active,
#   3306 listens on every address and bind-address has no effect.
# - PHP-FPM enabled, so the check page answers at the first boot.
# - The route, the check page and the appliance manifest in place, and no
#   manifest of a database layer beside it: mariadb.yaml has the base
#   core, and two manifests that no other is built on leave keel inspect
#   unable to name the appliance.
# - Webmin's PHP module pointed at PHP-FPM's php.ini, not Apache's.
# - No credential file of MariaDB in the image.
#
# KEEL_CONF_ROOT is the tree to work on, empty (the chroot's /) in a
# build; tests/image-check.bats sets it to a scratch tree.
root="${KEEL_CONF_ROOT:-}"
failed=0

fatal() {
    echo "FATAL: $*" >&2
    failed=1
}

# installed PACKAGE-GLOB: the names of the installed packages that match,
# from the dpkg status file of the tree
installed() {
    local name="" status
    while IFS= read -r line; do
        case "$line" in
            "Package: "*) name=${line#Package: } ;;
            "Status: "*)
                status=${line#Status: }
                # shellcheck disable=SC2053
                [[ "$status" == "install ok installed" && "$name" == $1 ]] && echo "$name"
                ;;
        esac
    done < "$root/var/lib/dpkg/status"
}

for glob in apache2 'libapache2-mod-php*'; do
    for name in $(installed "$glob"); do
        fatal "$name is installed: Keel LNMP serves PHP with nginx and PHP-FPM, never Apache"
    done
done

for unit in mariadb.socket mariadb-extra.socket; do
    if [ "$(readlink "$root/etc/systemd/system/$unit" 2>/dev/null || true)" != /dev/null ]; then
        fatal "$unit is not masked: 3306 would listen on every address"
    fi
done

if [ ! -L "$root/etc/systemd/system/multi-user.target.wants/php8.4-fpm.service" ]; then
    fatal "php8.4-fpm.service is not enabled: the check page would not answer"
fi

for path in /etc/nginx/keel-default.d/50-keel-lnmp.conf \
        /usr/share/keel-lnmp/www/keel-check/index.php \
        /usr/share/keel/appliances/lnmp.yaml; do
    if [ ! -f "$root$path" ]; then
        fatal "$path is not in the image"
    fi
done

for path in mariadb.yaml postgresql.yaml; do
    if [ -e "$root/usr/share/keel/appliances/$path" ]; then
        fatal "/usr/share/keel/appliances/$path is in the image: keel inspect could not name the appliance"
    fi
done

if ! grep -qE '^php_ini=/etc/php/[0-9.]+/fpm/php.ini=' "$root/etc/webmin/phpini/config" 2>/dev/null; then
    fatal "Webmin's PHP module does not open PHP-FPM's php.ini first (/etc/webmin/phpini/config)"
fi

if [ -e "$root/root/.my.cnf" ]; then
    fatal "/root/.my.cnf is in the image: a credential of MariaDB would be every machine's"
fi

exit "$failed"
